PORT=4000
# Local Postgres example:
# DATABASE_URL=postgresql://user:password@localhost:5432/url_shortener
# Neon example (copy the connection string from your Neon project dashboard —
# it already includes ?sslmode=require):
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/url_shortener?sslmode=require
BASE_URL=http://localhost:4000

# Upstash Redis: from your Upstash console, copy the "Redis URL" (standard
# protocol, starts with rediss://) — not the REST URL/token.
REDIS_URL=rediss://default:xxxxxx@xxxxx-xxxxx.upstash.io:6379
