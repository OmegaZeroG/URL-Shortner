PORT=4000
# Local Postgres example:
# DATABASE_URL=postgresql://user:password@localhost:5432/url_shortener
# Neon example (copy the connection string from your Neon project dashboard —
# it already includes ?sslmode=require):
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/url_shortener?sslmode=require
BASE_URL=http://localhost:4000

# Upstash Redis: from your Upstash console, copy the "Redis URL" (standard
# protocol, starts with rediss://) — not the REST URL/token.
REDIS_URL=rediss://default:xxxxxx@xxxxx-xxxxx.upstash.io:6379

# JWT signing secret — generate a real random value locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse this placeholder in production.
JWT_SECRET=replace-this-with-a-long-random-string

# Comma-separated list of origins allowed to call the API via fetch/XHR
# (CORS). Local dev default below; in production set this to your Vercel
# URL, e.g. https://om-url-shortener.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Worker id for the Snowflake ID generator (utils/snowflake.js), 0-1023.
# Only matters once you run more than one backend instance — each instance
# needs a distinct value so they never generate the same id. Safe to leave
# unset (defaults to 0) for a single-instance deploy like this project's.
SNOWFLAKE_WORKER_ID=0

# Sentry error tracking (src/instrument.js). Get this from your own Sentry
# project: sentry.io -> Create Project -> Node/Express -> Settings -> Client
# Keys (DSN). Optional — if unset, Sentry is skipped entirely and the app
# runs exactly as before.
SENTRY_DSN=
